# Comma-separated, explicit browser origins permitted for local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication is required for every application API. Missing identity config
# leaves sign-in unavailable; it never enables public demo access.
# See docs/authentication.md. Keep service-account files outside this repository.
# PRAMANA_FIREBASE_PROJECT_ID=your-firebase-project
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/pramana-service-account.json
# PRAMANA_IDENTITY_MEMBERSHIPS=[]
# Secure HTTPS cookies are the default. ONLY for local loopback HTTP development:
# PRAMANA_COOKIE_SECURE=0
# Firebase identities also require MONGODB_URI, PRAMANA_AUDIT_KEYS and
# PRAMANA_AUDIT_ACTIVE_KEY for encrypted workspace reviews.

# PostgreSQL is intentionally optional for this Day 1 demo. Leave unset when
# using the non-durable in-memory repository. Never commit a real connection string.
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/pramana

# Optional MongoDB review metadata. Set privately in .env / backend hosting secrets.
# If supplied, MongoDB must be reachable; the app never silently falls back to memory.
# MONGODB_URI=mongodb+srv://<user>:<encoded-password>@<atlas-host>/?retryWrites=true&w=majority
MONGODB_DB=pramana

# Fail startup rather than use temporary demo storage in a protected deployment.
# PRAMANA_REQUIRE_MONGODB=1
# PRAMANA_REQUIRE_AUDIT=1
# PRAMANA_REQUIRE_BUNNY=1
# Private originals: use Storage zone Access password, never a global API key.
# Hostname only, copied from the zone's Access page (no https://).
# BUNNY_STORAGE_HOST=sg.storage.bunnycdn.com
# BUNNY_STORAGE_ZONE=your-private-zone
# BUNNY_STORAGE_PASSWORD=your-zone-password

# Disposable PDF/image demo enabled; set 0 to disable. Use fictional files.
PRAMANA_ENABLE_LOCAL_INTAKE=1
# Windows: install Tesseract and set full paths (do not add literal quotes).
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_DIR=C:/Program Files/Tesseract-OCR/tessdata
# Linux container sets these paths in Dockerfile.
# Optional JSON overrides may LOWER hard ceilings; invalid settings fail startup.
# PRAMANA_INTAKE_LIMITS={"max_pages":5,"timeout_seconds":45,"ttl_seconds":600}

# Optional operator-owned approved visual manifest; never accept this path from a draft.
# Static HTML/CSS checks remain unavailable until configured. See docs/visual-checks.md.
# PRAMANA_VISUAL_MANIFEST_PATH=C:/path/to/approved-visual-manifest.json

# Authenticated audit (off until ALL required settings are supplied).
# Generate private values with scripts/create_audit_credentials.py; never commit them.
# PRAMANA_AUDIT_IDENTITIES=[{"token_sha256":"<sha256>","actor_id":"reviewer1","organization_id":"team1","role":"reviewer"}]
# PRAMANA_AUDIT_KEYS={"key1":"<base64-encoded-32-byte-key>"}
# PRAMANA_AUDIT_ACTIVE_KEY=key1
# PRAMANA_AUDIT_RETENTION_DAYS=30

