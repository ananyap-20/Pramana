# Public Firebase web-app configuration; never put Admin/OAuth secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-web-app-id
# Production must use same-site HTTPS frontend/API origins or a same-origin API
# reverse proxy. Unrelated vercel.app/onrender.com origins will not share Lax cookies.
